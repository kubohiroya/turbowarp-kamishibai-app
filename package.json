{
  "name": "@kubohiroya/turbowarp-kamishibai-app",
  "version": "4.0.0-rc.81",
  "private": false,
  "type": "module",
  "description": "TurboWarp-Kamishibai \u2014 an AI-powered interactive storytelling system built on the TurboWarp ecosystem, using Teachable Machine recognition as story input",
  "homepage": "https://kubohiroya.github.io/turbowarp-kamishibai-app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-kamishibai-app.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-kamishibai-app/issues"
  },
  "exports": {
    "./builder": {
      "types": "./dist/builder/index.d.ts",
      "import": "./dist/builder/index.js"
    },
    "./converter": {
      "types": "./dist/converter/index.d.ts",
      "import": "./dist/converter/index.js"
    },
    "./dsl4": {
      "types": "./dist/dsl4/index.d.ts",
      "import": "./dist/dsl4/index.js"
    },
    "./package.json": "./package.json",
    "./embedded-yaml": {
      "types": "./dist/dsl4/embedded-yaml-provider.d.ts",
      "import": "./dist/dsl4/embedded-yaml-provider.js"
    }
  },
  "bin": {
    "turbowarp-kamishibai": "bin/turbowarp-kamishibai.mjs",
    "tm-kamishibai": "bin/turbowarp-kamishibai.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "schema/dsl-4.schema.json",
    "schema/dsl-4-editor.schema.json",
    "schema/dsl-4-narrative-control.schema.json",
    "schema/dsl-4-asset-config.schema.json",
    "schema/dsl-4-asset-lock.schema.json",
    "README.md",
    "README.ja.md",
    "docs/dsl4-audio.md",
    "docs/dsl4-definition-audit.md",
    "LICENSE",
    "LICENSES.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "packageManager": "pnpm@11.28.8",
  "scripts": {
    "check": "pnpm verify:release",
    "build": "pnpm run build:site",
    "sb3:build": "pnpm release:dsl4:cut",
    "sb3:check": "pnpm sb3:dsl4-release:check",
    "sb3:dsl4-published-snapshot:check": "pnpm release:dsl4:verify-published-snapshot",
    "sb3:dsl4-release:check": "pnpm release:dsl4:check",
    "sb3:dsl4-release:write": "pnpm release:dsl4:update",
    "dsl4:assets:convert": "pnpm run build:lib && node bin/turbowarp-kamishibai.mjs convert-dsl4-assets",
    "posenet-bundle-assets:generate": "node scripts/generate-posenet-bundle-assets.ts",
    "dsl4:playback-runtime:generate": "pnpm run build:lib && node scripts/generate-dsl4-playback-runtime.mjs",
    "export-block-dsl": "pnpm run build:lib && node scripts/export-block-dsl.mjs",
    "smoke:dsl4-packager-binary-memory": "pnpm run build:lib && node scripts/smoke/dsl4-packager-binary-memory.ts",
    "e2e": "pnpm e2e:preview && pnpm e2e:chromium",
    "e2e:preview": "pnpm run build:lib && vitest run test/dsl4-browser-preview-source-adapter.test.ts test/dsl4-preview-source-protocol-port.test.ts test/dsl4-web-preview-shell.test.ts test/dsl4-browser-preview-asset-adapter.test.ts test/dsl4-browser-asset-reload-pipeline.test.ts test/dsl4-preview-reload-overlay.test.ts",
    "e2e:chromium": "pnpm run build:lib && vitest run --config vitest.e2e.config.ts",
    "e2e:chromium:preview": "pnpm run build:lib && vitest run --config vitest.e2e.config.ts test/e2e/dsl4-web-preview-chromium.test.ts",
    "e2e:chromium:distribution": "pnpm run build:lib && vitest run --config vitest.e2e.config.ts test/e2e/dsl4-asset-distribution-offline-chromium.test.ts",
    "lint": "eslint .",
    "lint:prune-suppressions": "eslint . --prune-suppressions && prettier --write eslint-suppressions.json",
    "format": "prettier --check \"**/*.{js,mjs,cjs,ts}\" \".github/**/*.{yaml,yml}\" \"*.{json,md,yaml,yml}\"",
    "typecheck": "node scripts/tsc.ts --project tsconfig.json",
    "test": "pnpm test:full",
    "test:video-listening": "vitest run test/video-listening-audit.test.ts",
    "test:quick": "pnpm run build:lib && node scripts/test/run-suite.mjs quick",
    "test:full": "pnpm run build:lib && node scripts/test/run-suite.mjs full",
    "verify:quick": "pnpm lint && pnpm typecheck && pnpm test:quick",
    "verify:pr": "pnpm sb3:check && pnpm lint && pnpm format && pnpm typecheck && pnpm test:quick",
    "verify:full": "pnpm sb3:check && pnpm lint && pnpm format && pnpm typecheck && pnpm test:full && pnpm e2e && pnpm build && pnpm pack:smoke",
    "verify:release": "pnpm verify:full",
    "deploy": "pnpm run build:site && node scripts/deploy-site.ts",
    "pack:check": "pnpm run build:lib && npm pack --dry-run --ignore-scripts",
    "pack:smoke": "pnpm run build:lib && node scripts/verify-package.ts",
    "release:check": "npm publish --dry-run --access public --tag next",
    "release:dsl4:cut": "pnpm run build:lib && node scripts/sb3/dsl4-release-workflow.ts cut",
    "release:dsl4:update": "pnpm run build:lib && node scripts/sb3/dsl4-release-workflow.ts update",
    "release:dsl4:check": "pnpm run build:lib && node scripts/sb3/dsl4-release-workflow.ts check",
    "release:dsl4:verify-published-snapshot": "pnpm run build:lib && node scripts/sb3/dsl4-release-workflow.ts verify-published-snapshot",
    "release:dsl4:freeze": "pnpm run build:lib && node scripts/sb3/dsl4-release-workflow.ts freeze",
    "release:dsl4:record-publication": "pnpm run build:lib && node scripts/sb3/dsl4-release-workflow.ts record-publication",
    "prepack": "pnpm lint && pnpm format && pnpm typecheck && pnpm build:lib && vitest run test/builder.test.ts test/dsl32-converter.test.ts && pnpm pack:smoke",
    "turbowarp-kamishibai": "pnpm run build:lib && node bin/turbowarp-kamishibai.mjs",
    "build:lib": "node scripts/build-lib.ts",
    "build:site": "node scripts/build-site.ts",
    "dev": "pnpm run build:lib && tsc --project tsconfig.build.json --watch",
    "release:finalize": "node scripts/finalize-release-tags.ts"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "teachable-machine",
    "pose-recognition",
    "image-recognition",
    "audio-recognition",
    "kamishibai"
  ],
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "license": "MPL-2.0",
  "dependencies": {
    "@kubohiroya/turbowarp-app-shell": "^0.6.0",
    "@kubohiroya/turbowarp-asset-cache": "^0.6.0",
    "@kubohiroya/turbowarp-async-input": "^0.11.0",
    "@kubohiroya/turbowarp-bubble": "^0.16.0",
    "@kubohiroya/turbowarp-camera-source": "^0.22.1",
    "@kubohiroya/turbowarp-extension-loader": "0.5.0",
    "@kubohiroya/turbowarp-extension-manifest": "^0.5.0",
    "@kubohiroya/turbowarp-kvs": "^0.5.1",
    "@kubohiroya/turbowarp-live-reload-controller": "^0.4.0",
    "@kubohiroya/turbowarp-local-preview": "^0.3.0",
    "@kubohiroya/turbowarp-runtime-adapter": "^0.5.0",
    "@kubohiroya/turbowarp-runtime-expression": "^0.9.0",
    "@kubohiroya/turbowarp-sb3-save-format": "0.2.0-rc.0",
    "@kubohiroya/turbowarp-svg-text": "^0.13.0",
    "@kubohiroya/turbowarp-teachable-machine": "^4.1.0",
    "@teachablemachine/pose": "0.8.6",
    "@tensorflow/tfjs": "4.22.0",
    "@turbowarp/scratch-storage": "2.0.0",
    "@turbowarp/scratch-svg-renderer": "1.1.0",
    "ajv": "8.20.0",
    "base64-js": "1.5.1",
    "brfs": "2.0.2",
    "buffer": "6.0.3",
    "fflate": "0.8.3",
    "scratch-audio": "github:TurboWarp/scratch-audio#aba00cd02e36d95407effafa03f3678e4c669b30",
    "scratch-render": "github:TurboWarp/scratch-render#a67f7c9c07d459582c227d4fd3fae8f59d8fc9ce",
    "scratch-vm": "github:TurboWarp/scratch-vm#c4823421cb7c17d8d8a89878851ce1668c26a21f",
    "vite": "^8.3.3",
    "yaml": "2.9.1",
    "@kubohiroya/turbowarp-document-source": "git+https://github.com/kubohiroya/turbowarp-document-source.git#a6669566d50062abb39acbb475811cb982e4d85c",
    "@kubohiroya/turbowarp-document-data": "0.5.0-rc.1",
    "@kubohiroya/turbowarp-yaml-json": "0.8.0-rc.0"
  },
  "devDependencies": {
    "@kubohiroya/sb3-toolchain": "^0.20.0",
    "@kubohiroya/turbowarp-kamishibai-site-navigation": "^0.4.0",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.10.0",
    "@turbowarp/packager": "3.14.0",
    "@turbowarp/sbdl": "7.0.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "fake-indexeddb": "6.2.7",
    "gh-pages": "^6.3.0",
    "globals": "17.13.0",
    "playwright-core": "1.65.0-alpha-1792021904000",
    "prettier": "^3.9.9",
    "scratch-parser": "6.0.1",
    "scratch-render-fonts": "github:TurboWarp/scratch-render-fonts#7b6768fc6dfef6b343a06f992587b74807043961",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "^5.0.3",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
